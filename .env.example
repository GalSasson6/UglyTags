DISCORD_TOKEN=
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://uglytags:replace-with-a-strong-password@uglytags-db:5432/uglytags
UGLYTAGS_IMAGE=ghcr.io/dvir001/uglytags:latest
MAX_MEDIA_MB=20

# Optional /tag import limits: the import file's size, attachment links downloaded per
# import, and total downloaded data per import. Raise them for large one-time migrations.
MAX_IMPORT_MB=50
MAX_IMPORT_DOWNLOADS=500
MAX_IMPORT_DOWNLOAD_MB=200

# Optional local development server for immediate command registration.
# For local runs, change DATABASE_URL's host from uglytags-db to your PostgreSQL host.
DISCORD_TEST_GUILD_ID=
